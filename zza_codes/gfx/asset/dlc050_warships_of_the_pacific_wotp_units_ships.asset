#USS LANGLEY
entity = { 
	name = "USA_carrier_0_entity"
	pdxmesh = "USA_carrier_langley_mesh"
	
	locator = { name = "idle_foam"	position = { 0.0 -0.1 0.0 } }

	default_state = idle
	state = { name = "idle"	animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 chance = 1 looping = no 
		event = { time = 0 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes  }
		event = { trigger_once = yes time = 0 sound = { soundeffect = ship_carrier_small_idle }}
	}

	state = { name = "idle"				animation = "takeoff" 		animation_blend_time = 0.3 animation_speed = 1.0 chance = 1 looping = no 
		event = { time = 0 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 8 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 12 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 18 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 22 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 28 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 32 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 38 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 42 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 48 node = "idle_foam" particle = "ship_idle_particle"  keep_particle = yes   }
		event = { time = 12 node = "idle_foam" node = "flying_plane_loc" particle = "air_trail_particle"  keep_particle = yes   }
		event = { trigger_once = yes time = 0 sound = { soundeffect = ship_carrier_small_idle }}
		event = { time = 0 trigger_once = yes sound = { soundeffect = USA_carrier_0_entity } }
	}


	state = { name = "move"				animation = "idle"   animation_blend_time = 0.3
		event = { trigger_once = yes time = 0 sound = { soundeffect = ship_carrier_small_move }}
	}

	state = { name = "death"			animation = "death" animation_blend_time = 0.3 looping = no 
		event = { time = 0 node = "explosion_death_locator" particle = "ship_medium_explosion_particle" keep_particle = yes }
#		event = { time = 2.5 node = "airplane_locator_1" particle = "water_impact_particle" keep_particle = yes }
#		event = { time = 2.5 node = "airplane_locator_2" particle = "water_impact_particle" keep_particle = yes }
#		event = { time = 2.5 node = "airplane_locator_3" particle = "water_impact_particle" keep_particle = yes }
		event = { time = 6.2 particle = "ship_idle_particle"  keep_particle = yes  }
		event = { time = 0 sound = { soundeffect = super_heavy_battleship_destroyed }}
	}
	
	scale = 2.1
}

