		state = { name = "training"				animation = "aim_exercise" 		animation_blend_time = 0.3 animation_speed = 1.0 chance = 1 looping = no }
		
		attach = { 	name = "rifle1"	Right_Hand_node = "SIA_infantry_weapon_rifle_right_entity" }	
		attach = { 	name = "rifle2"	Left_Hand_node = "SIA_infantry_weapon_rifle_left_entity" }
		attach = { 	name = "rifle4"	Root_node_2 = "SIA_infantry_weapon_rifle_right_entity" }
		
		scale = 0.8			
