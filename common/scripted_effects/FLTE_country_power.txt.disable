FLTE_EFFECT_power_init_country = {
	# 初始化国家变量
	set_variable = { FLTE_power_industry_civilian = 0 }
	set_variable = { FLTE_power_industry_military = 0 }
	set_variable = { FLTE_power_industry_dockyard = 0 }
	set_variable = { FLTE_power_land = 0 }
	set_variable = { FLTE_power_navy = 0 }
	set_variable = { FLTE_power_air = 0 }
	set_variable = { FLTE_power_missile = 0 }
}
FLTE_power_update_industry = {
	set_variable = { FLTE_power_industry_civilian = 0 }
	set_variable = { FLTE_power_industry_military = 0 }
	set_variable = { FLTE_power_industry_dockyard = 0 }

	set_variable = { FLTE_power_industry_civilian = FLTE_civilian_factories_output }
	add_to_variable = { FLTE_power_industry_civilian = var:modifier@cic_construction_boost }
	set_variable = { FLTE_temp_modifier_factor = var:modifier@cic_construction_boost_factor }
	add_to_variable = { FLTE_temp_modifier_factor = 1 }
	clamp_variable = { var = FLTE_temp_modifier_factor min = 0.5 max = 999 }
	multiply_variable = { FLTE_power_industry_civilian = FLTE_temp_modifier_factor }
	multiply_variable = { FLTE_power_industry_civilian = var:num_of_civilian_factories }
	set_variable = { FLTE_temp_modifier_factor = var:modifier@production_speed_buildings_factor }
	add_to_variable = { FLTE_temp_modifier_factor = 1 }
	clamp_variable = { var = FLTE_temp_modifier_factor min = 0.5 max = 999 }
	multiply_variable = { FLTE_power_industry_civilian = FLTE_temp_modifier_factor }
	round_variable = FLTE_power_industry_civilian

	set_variable = { FLTE_power_industry_military = FLTE_military_factories_output }
	multiply_variable = { FLTE_power_industry_military = var:num_of_military_factories }
	set_variable = { FLTE_temp_modifier_factor = var:modifier@industrial_capacity_factory }
	add_to_variable = { FLTE_temp_modifier_factor = 1 }
	clamp_variable = { var = FLTE_temp_modifier_factor min = 0.5 max = 999 }
	multiply_variable = { FLTE_power_industry_military = FLTE_temp_modifier_factor }
	# y = 6x/(2+x) - 1 | y = (K * x) / (C + x) + A -> y = K/C + A -> y = K + A -> y = K
	set_variable = { FLTE_temp_modifier_factor = var:modifier@production_factory_start_efficiency_factor }
	add_to_variable = { FLTE_temp_modifier_factor = 1 }
	clamp_variable = { var = FLTE_temp_modifier_factor min = 0.5 max = 999 }
	set_temp_variable = { FLTE_modifier_industrial_capacity_factory_K = 6 }
	set_temp_variable = { FLTE_modifier_industrial_capacity_factory_C = 2 }
	set_temp_variable = { FLTE_modifier_industrial_capacity_factory_A = -1 }
	multiply_temp_variable = { FLTE_modifier_industrial_capacity_factory_K = FLTE_temp_modifier_factor }
	add_to_temp_variable = { FLTE_modifier_industrial_capacity_factory_C = FLTE_temp_modifier_factor }
	divide_temp_variable = { FLTE_modifier_industrial_capacity_factory_K = FLTE_modifier_industrial_capacity_factory_C }
	add_to_temp_variable = { FLTE_modifier_industrial_capacity_factory_K = FLTE_modifier_industrial_capacity_factory_A }
	multiply_temp_variable = { FLTE_power_industry_military = FLTE_modifier_industrial_capacity_factory_K }
	round_variable = FLTE_power_industry_military

	set_variable = { FLTE_power_industry_dockyard = FLTE_dockyard_output }
	multiply_variable = { FLTE_power_industry_dockyard = var:num_of_naval_factories }
	set_variable = { FLTE_temp_modifier_factor = var:modifier@industrial_capacity_dockyard }
	add_to_variable = { FLTE_temp_modifier_factor = 1 }
	clamp_variable = { var = FLTE_temp_modifier_factor min = 0.5 max = 999 }
	multiply_variable = { FLTE_power_industry_dockyard = FLTE_temp_modifier_factor }
	round_variable = FLTE_power_industry_dockyard
}
